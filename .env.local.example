# Dirección del nodo RPC de la red Casper
# Ejemplos:
#   Testnet: https://rpc.testnet.casperlabs.io
#   Mainnet: https://rpc.mainnet.casperlabs.io
#   Local: http://localhost:7777/rpc
NODE_ADDRESS=https://rpc.testnet.casperlabs.io

# Nombre de la red Casper
# Valores permitidos: mainnet, testnet, casper-test, localhost, integration-test
NETWORK_NAME=casper-test

# Clave pública del sponsor (formato hexadecimal, típicamente empieza con 01 o 02 para Ed25519)
# Ejemplo: 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123
# Longitud: 66 caracteres (con prefijo) o 64 caracteres (sin prefijo)
SPONSOR_PUBLIC_KEY=01...

# Clave privada del sponsor
# ⚠️ NUNCA compartas esta clave. Solo debe estar en archivos locales y nunca en el repositorio
# Formatos aceptados:
#   - ed25519:... (formato hexadecimal con prefijo)
#   - Formato PEM (-----BEGIN EC PRIVATE KEY-----)
SPONSOR_PRIVATE_KEY=ed25519:...

# Clave pública del sponsor para uso en el cliente (navegador)
# Esta variable es pública y se expone al cliente mediante NEXT_PUBLIC_
# Debe ser la misma que SPONSOR_PUBLIC_KEY pero expuesta al frontend
NEXT_PUBLIC_SPONSOR_PUBLIC_KEY=01...

# CSPR.click App ID (obtener en https://accounts.cspr.click)
# Si no está configurado, CSPR.click no funcionará y mostrará errores 401
# Obtén tu App ID registrándote en: https://accounts.cspr.click
NEXT_PUBLIC_CSPR_CLICK_APP_ID=
